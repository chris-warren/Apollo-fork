# Copy to .env (not committed) and fill in for this machine. train.py loads it
# automatically; variables already set in the environment take precedence.

# Root of the generated data (README.md, hdf5_train/, eval/, test/ inside).
APOLLO_DATA=~/projects/def-<pi>/<user>/data/processed/apollo_v1

# DRAC compute nodes have no internet: log to disk, sync later with `wandb sync`.
WANDB_MODE=offline
